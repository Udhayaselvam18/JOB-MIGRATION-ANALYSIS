import gradio as gr
import pandas as pd
import joblib

# Load trained model
model_data = joblib.load("/content/random_forest_retrained_model.pkl")

# Extract model and feature names
rf_model = model_data["model"]
feature_names = model_data["features"]  # Ensure correct feature names

# Define categorical mappings
categorical_mappings = {
    "Skill Level": {"Low": 0, "Medium": 1, "High": 2},
    "Job Sector": {"IT": 0, "Healthcare": 1, "Education": 2, "Finance": 3, "Hospitality" : 4, "Engineering" : 5},
    "Cause of Migration": {"Better Job": 0, "Higer Salary": 1, "Education": 2, "Quality of Life": 3, "Remoter Work" : 4, "Political Stability" : 5, "Family" : 6}
}

# Define country mappings (output)
country_mappings = {
    0: "USA",
    1: "Canada",
    2: "Germany",
}

# Function to preprocess input and predict
def predict_country(job_sector, skill_level, salary, cause_of_migration):
    try:
        # Convert categorical inputs to numerical values
        job_sector = categorical_mappings["Job Sector"].get(job_sector, -1)
        skill_level = categorical_mappings["Skill Level"].get(skill_level, -1)
        cause_of_migration = categorical_mappings["Cause of Migration"].get(cause_of_migration, -1)

        # Ensure valid category selection
        if -1 in [job_sector, skill_level, cause_of_migration]:
            return "Error: Invalid category selection"

        # Create DataFrame for the model with correct feature names
        user_input = pd.DataFrame([[job_sector, skill_level, salary, cause_of_migration]],
                                  columns=feature_names)  # Ensure columns match trained model

        # Make prediction
        predicted_country_num = rf_model.predict(user_input)[0]

        # Convert number to country name
        predicted_country = country_mappings.get(predicted_country_num, "Unknown Country")

        return f"Predicted Country: {predicted_country}"

    except Exception as e:
        return f"Error: {str(e)}"

# Gradio UI
with gr.Blocks() as demo:
    gr.Markdown("# 🌍 Country Predictor")

    job_sector_input = gr.Dropdown(choices=list(categorical_mappings["Job Sector"].keys()), label="Job Sector")
    skill_level_input = gr.Dropdown(choices=list(categorical_mappings["Skill Level"].keys()), label="Skill Level")
    salary_input = gr.Number(label="Avg Salary (USD)")
    cause_of_migration_input = gr.Dropdown(choices=list(categorical_mappings["Cause of Migration"].keys()), label="Cause of Migration")

    output_text = gr.Textbox(label="Predicted Country")

    submit_btn = gr.Button("Predict")

    submit_btn.click(
        predict_country,
        inputs=[job_sector_input, skill_level_input, salary_input, cause_of_migration_input],
        outputs=output_text
    )

# Launch app
demo.launch()
