import pandas as pd
import numpy as np
import joblib
import os

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.svm import SVC
from sklearn.metrics import accuracy_score, classification_report, log_loss
from imblearn.over_sampling import RandomOverSampler

# ✅ Correct file path
file_path = "/migration_dataset_5000.csv"
df = pd.read_csv(file_path)

# Drop missing values
df.dropna(inplace=True)

# ✅ Target variable = Destination_Country
target_column = "Destination_Country"

# Separate target first
y = df[target_column]
X = df.drop(columns=[target_column])

# Encode categorical features
label_encoders = {}
for col in X.select_dtypes(include=['object']).columns:
    le = LabelEncoder()
    X[col] = le.fit_transform(X[col])
    label_encoders[col] = le

# Encode target separately
target_encoder = LabelEncoder()
y = target_encoder.fit_transform(y)

# Balance classes
ros = RandomOverSampler(random_state=42)
X_resampled, y_resampled = ros.fit_resample(X, y)

# Train test split
X_train, X_test, y_train, y_test = train_test_split(
    X_resampled, y_resampled, test_size=0.2, random_state=42
)

# Scale features
scaler = StandardScaler()
X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)

# Models
models = {
    "Random Forest": RandomForestClassifier(n_estimators=200, random_state=42),
    "Gradient Boosting": GradientBoostingClassifier(n_estimators=200, random_state=42),
    "Logistic Regression": LogisticRegression(max_iter=500),
    "SVM": SVC(kernel='linear', probability=True)
}

best_model = None
best_accuracy = 0
best_trained_model = None

print("Model Accuracies:\n")

for name, model in models.items():
    model.fit(X_train, y_train)
    y_pred = model.predict(X_test)
    acc = accuracy_score(y_test, y_pred)
    print(f"{name}: {acc:.4f}")

    if acc > best_accuracy:
        best_accuracy = acc
        best_model = name
        best_trained_model = model

print(f"\nBest Model: {best_model} ({best_accuracy:.4f})")

# Detailed metrics
print("\nDetailed Metrics:\n")

for name, model in models.items():
    y_pred = model.predict(X_test)
    y_proba = model.predict_proba(X_test)

    report = classification_report(y_test, y_pred)
    loss = log_loss(y_test, y_proba)

    print(f"\n{name}")
    print(report)
    print(f"Log Loss: {loss:.4f}")

# Create the directory if it doesn't exist
os.makedirs("/content/", exist_ok=True)

# ✅ Save best model
joblib.dump({
    "model": best_trained_model,
    "scaler": scaler,
    "target_encoder": target_encoder,
    "feature_encoders": label_encoders,
    "feature_names": X.columns.tolist()
}, "/content/best_migration_model.pkl")

print("\nModel saved as best_migration_model.pkl")

# ✅ Decode predictions
y_pred = best_trained_model.predict(X_test)
decoded = target_encoder.inverse_transform(y_pred)

pred_df = pd.DataFrame(decoded, columns=["Predicted_Destination_Country"])
top_countries = pred_df["Predicted_Destination_Country"].value_counts().reset_index()
top_countries.columns = ["Country", "Predicted_Migrants"]

top_countries.to_csv("/content/future_migration_predictions.csv", index=False)
